{
  "name": "bersantai",
  "private": true,
  "version": "0.1.0",
  "description": "Bersantai full-stack application foundation.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "test": "npm run test -ws",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "lint": "npm run lint -ws --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
